Training_data =
    SELECT *
    FROM (SSTREAM @In_Training_data);

IDF_NoduleRank =
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_06/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_07/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_08/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_09/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_10/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_11/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_12/IDF/IDF_NoduleRank.ss")
    UNION
    SELECT * FROM (SSTREAM "/local/users/v-yangtian/OpenL1/2026_08_13/IDF/IDF_NoduleRank.ss");  

UrlHashMatchResult =
    SELECT UU.TypeName,
           UU.UrlHash16B,
           INR.Key,
           INR.PKey,
           INR.MUrl,
           INR.PUrl,
           INR.IDFBlob,
           INR.StaticRank,
           IF(INR.UrlHash16B == null, "Unmatched", "Matched") AS MatchStatus
    FROM Training_data AS UU
         LEFT JOIN IDF_NoduleRank AS INR
             ON UU.UrlHash16B == INR.UrlHash16B;

UrlHashMatchResult_TypeCounts =
    SELECT TypeName,
           COUNT() AS TotalCount,
           COUNTIF(MatchStatus == "Matched") AS MatchedCount,
           COUNTIF(MatchStatus == "Unmatched") AS UnmatchedCount
    FROM UrlHashMatchResult
    GROUP BY TypeName;

UrlHashMatchResult_TypeStats =
    SELECT TypeName,
           TotalCount,
           MatchedCount,
           UnmatchedCount,
           MatchedCount * 1.0 / TotalCount AS MatchedPercentage,
           UnmatchedCount * 1.0 / TotalCount AS UnmatchedPercentage
    FROM UrlHashMatchResult_TypeCounts
    UNION ALL
    SELECT "Total" AS TypeName,
           SUM(TotalCount) AS TotalCount,
           SUM(MatchedCount) AS MatchedCount,
           SUM(UnmatchedCount) AS UnmatchedCount,
           SUM(MatchedCount) * 1.0 / SUM(TotalCount) AS MatchedPercentage,
           SUM(UnmatchedCount) * 1.0 / SUM(TotalCount) AS UnmatchedPercentage
    FROM UrlHashMatchResult_TypeCounts;

OUTPUT UrlHashMatchResult_TypeStats
TO SSTREAM @Output_Stats_Folder + "UrlHashMatchResult_TypeStats.ss";


//sample 8B from IDF_NoduleRank
Sample_Nodule =
    SELECT *
    FROM IDF_NoduleRank
    SAMPLE UNIFORM (0.347827);


index =
    SELECT  MUrl,
            PUrl,
            IDFBlob AS IdfBlob,
            GetDomain(PUrl) AS PDomain,
            UrlHash16B,
            StaticRank
    FROM Sample_Nodule
    UNION
    SELECT 
            MUrl,
            PUrl,
            IDFBlob AS IdfBlob,
            GetDomain(PUrl) AS PDomain,
            UrlHash16B,
            StaticRank
    FROM UrlHashMatchResult WHERE MatchStatus == "Matched";


index =
    SELECT Key, 
           PKey,
           FIRST(MUrl) AS MUrl,
           FIRST(PUrl) AS PUrl,
           FIRST(StaticRank) AS StaticRank,
           FIRST(IDFBlob) AS IDFBlob FROM index;
    GROUP BY Key, PKey;


index =
    SELECT index.*,
           UrlHashToPartitionId(UrlHash16B) AS PartitionId;

stat =
    SELECT COUNT() AS TotalCount
    FROM index;

OUTPUT stat
TO SSTREAM @Out_Stat;

#DECLARE i int = 0;
LOOP(i, 32)
{
    index_0 =
        SELECT *.Except(PartitionId)
        FROM index
        WHERE 512 * @@i@@ <= PartitionId
              AND PartitionId < 512 * (@@i@@ + 1);

    OUTPUT index_0
    TO SSTREAM (@Output_Folder + "Data_Segment_@@i@@.ss")
    HASH CLUSTERED BY UrlHash16B
    INTO 2000
    SORTED BY UrlHash16B;
}

#CS
using Microsoft.SCOPE.Types;
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using ScopeRuntime;
using Microsoft.Bing.HashUtil;

public static byte[] ParseHexString(string hex)
{
    byte[] hash = new byte[16];
    for (int i = 0; i < hex.Length / 2; i++)
    {
        var upper = Convert.ToByte(hex.Substring(2 * i, 1), 16);
        var lower = Convert.ToByte(hex.Substring(2 * i + 1, 1), 16);
        if (upper <= 0x0F && lower <= 0x0F)
        {
            hash[i] = (byte)(lower | (upper << 4));
        }
        else
        {
            return new byte[16];
        }
    }

    return hash;
}

Int64 UrlHashToPartitionId(string urlHash)
{
    byte[] bytes = ParseHexString(urlHash);
    var hashLow = BitConverter.ToUInt64(bytes, 0);
    var hashHigh = BitConverter.ToUInt64(bytes, 8);
    // Use lower bits (first 8 bytes) to generate partition id
    Int64 partitionId = (Int64)((hashLow >> 4) % 16384);
    return partitionId;
}

public static string GetCombinedHash(string mUrl, string pUrl)
{
    string mKey = HutHash.GetUrlHashAsBase64String(mUrl);
    string pKey = HutHash.GetUrlHashAsBase64String(pUrl);
    byte[] bCodes = HutHash.GetHashAsBinary(mKey + pKey);
    return string.Concat(bCodes.Select(b => b.ToString("X2")));
}

public static string GetDomain(string url)
{
    string domain, host, l1path;

    if (MMRV2.ScheduleSelection.Tool.ParseUrl(out domain, out host, out l1path, url))
    {
        return domain;
    }

    return null;
}

#ENDCS
