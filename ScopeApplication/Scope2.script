file1 =
    EXTRACT qid:string,
            docid:string,
            Score:double
    FROM @"/local/users/v-yangtian/2026_09_03/DocXtreme/NoduleNGramPairs.tsv"
    USING Extractors.Tsv(skipFirstNRows: 1);

file2 =
    EXTRACT qid:string,
            docid:string,
            Score:double
    FROM @"/local/Prod/Image/Repository/Sensor/WDP/2026_09_03/DocXtreme/NoduleNGramPairs.tsv"
    USING Extractors.Tsv(skipFirstNRows: 1);


diff1 =
    SELECT qid, docid, Score
    FROM file1
    EXCEPT
    SELECT qid, docid, Score
    FROM file2;

diff2 =
    SELECT qid, docid, Score
    FROM file2
    EXCEPT
    SELECT qid, docid, Score
    FROM file1;


diff =
    SELECT * FROM diff1
    UNION ALL
    SELECT * FROM diff2;


OUTPUT diff
TO @"/local/users/v-yangtian/2026_09_03/DocXtreme/diff.tsv"
USING Outputters.Tsv();